# 复制本文件为 .streamlit/secrets.toml 后填真实值。
# secrets.toml 已被 .gitignore 排除，不要提交到仓库，也不要写进任何 .py 文件。
#
# 不填也能跑：Agent 会自动使用规则版决策器，检测/规划功能不受影响。
# 三项（BASE / MODEL / KEY）必须同时有非空值才算「已配置」，缺一项按未配置处理。
#
# 配好后先自检：.venv\Scripts\python.exe check_llm.py
# 改完本文件需重启 streamlit（页面热重载不会重读密钥）。

# ── 主选：DeepSeek ────────────────────────────────────────────────────────
LLM_BASE_URL = "https://api.deepseek.com/v1"   # 必须带版本段，代码只在其后拼 /chat/completions
LLM_MODEL = "deepseek-v4-flash"                # 注意：deepseek-chat 已于 2026-07-24 停用，写它必 404
LLM_TIMEOUT = 30                               # 秒；超时即回退规则版
LLM_TEMPERATURE = 0                            # 决策任务建议 0
LLM_THINKING = "auto"                          # auto = 对 deepseek/qwen 自动关闭思考；0 强制关，1 强制开

# 去掉下面这行的 # 并替换成真实密钥（形如 sk-xxxxxxxx）
# LLM_API_KEY = "sk-xxxxxxxxxxxxxxxx"

# ── 备选服务商：同样 OpenAI 兼容，改上面三行即可，代码不用动 ──────────────
#
# 智谱 GLM —— glm-4.7-flash 永久免费（并发 1，够单人答辩演示）
#   LLM_BASE_URL = "https://open.bigmodel.cn/api/paas/v4"
#   LLM_MODEL    = "glm-4.7-flash"
#
# 阿里百炼 —— 新账号送 100 万 token / 90 天；qwen3.7-flash 约 0.2 元/百万输入
#   LLM_BASE_URL = "https://dashscope.aliyuncs.com/compatible-mode/v1"
#   LLM_MODEL    = "qwen3.7-flash"
#   （代码会按模型名自动补 enable_thinking=false，避免它默认先思考、拖慢响应）
#
# 注意：本文件里的键会被 Streamlit 同步进环境变量。若你习惯用环境变量传密钥，
# 这里不要留 LLM_API_KEY = ""，否则会把真实环境变量冲成空值。
